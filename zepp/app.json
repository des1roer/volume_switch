{
  "configVersion": "v3",
  "app": {
    "appId": 1097781,
    "appName": "MPC Remote",
    "appType": "app",
    "version": {
      "code": 1,
      "name": "1.0.0"
    },
    "icon": "icon.png",
    "vender": "des1roer",
    "description": "MPC-HC remote for volume_switch"
  },
  "permissions": ["data:os.device.info"],
  "runtime": {
    "apiVersion": {
      "compatible": "4.0",
      "target": "4.0",
      "minVersion": "4.0"
    }
  },
  "targets": {
    "round": {
      "module": {
        "page": {
          "pages": ["page/index"]
        },
        "app-side": {
          "path": "app-side/index"
        },
        "setting": {
          "path": "setting/index"
        }
      },
      "platforms": [
        {
          "st": "r",
          "dw": 480
        }
      ]
    }
  },
  "i18n": {
    "en-US": {
      "appName": "MPC Remote"
    },
    "ru-RU": {
      "appName": "Пульт MPC"
    }
  },
  "defaultLanguage": "en-US"
}
